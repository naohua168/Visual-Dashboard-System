{
  "_说明": "前端看板展示控制配置 — 控制HTML看板的页面/颜色/标题等展示内容",

  "看板标题": {
    "标题": "销售运营可视化看板",
    "副标题": ""
  },

  "页面顺序": {
    "_说明": "按数组顺序渲染导航栏和页面。删除某个条目则对应页面不显示。当前 6 页",
    "顺序": ["数据总览", "年度达成", "月度达成", "季度达成", "销售达成", "年度同比"]
  },

  "页面映射": {
    "数据总览": {"page_id": "overview", "nav_name": "数据总览"},
    "年度达成": {"page_id": "annual", "nav_name": "年度达成"},
    "月度达成": {"page_id": "monthly", "nav_name": "月度达成"},
    "季度达成": {"page_id": "quarterly", "nav_name": "季度达成"},
    "销售达成": {"page_id": "sales", "nav_name": "销售达成"},
    "年度同比": {"page_id": "yoy", "nav_name": "年度同比"}
  },

  "事业部": {
    "_说明": "四个事业部的显示名称和主题色",
    "列表": ["检测", "信息", "能源", "海外"],
    "颜色": {
      "检测": "#2563eb",
      "信息": "#8b5cf6",
      "能源": "#f59e0b",
      "海外": "#0d9488"
    }
  },

  "KPI通用": {
    "收入标签": "收入",
    "回款标签": "回款",
    "金额单位": "万元",
    "完成率格式": "{:.1f}%"
  },
  "各页Hero中间区": {
    "_说明": "每页 Hero 中间区实际展示内容。total_tgt 传入 → 显示'XX总指标'大数字；null → 显示'收入实际|回款实际'双栏",
    "数据总览": {"中间模式": "实际值双栏", "显示内容": "收入实际 | 回款实际"},
    "年度达成": {"中间模式": "总指标", "标签": "年度总指标"},
    "月度达成": {"中间模式": "总指标", "标签": "月度总指标"},
    "季度达成": {"中间模式": "总指标", "标签": "本期总指标"},
    "销售达成": {"中间模式": "总指标", "标签": "年度总指标"},
    "年度同比": {"中间模式": "同比大卡", "显示内容": "今年vs去年柱状对比（不使用Hero组件）"}
  },

  "文件输出": {
    "目录": "output",
    "看板文件名": "看板_{date}.html",
    "数据文件名": "data_{date}.xlsx"
  }
}
