{
  "_说明": "数据清洗引擎(Phase 0/1/2)及渲染层(Phase 4)核心配置。",

  "数据源": {
    "_说明": "两套独立数据：财务端需过客户白名单 → 列映射含部门/法人主体。运营端全量保留 → 列映射含内部交易/核算单位。",

    "财务端": {
      "文件夹": "data/raw/财务端数据",

      "收入": {
        "文件名": "收入.xlsx",
        "Sheet": ["Sheet1"],
        "引擎": "openpyxl",
        "列映射": {
          "日期": ["创建时间", "创建日期", "审核日期"],
          "客户": ["客户.名称", "客户名称", "客户.姓名"],
          "金额": ["不含税金额", "含税金额", "金额", "含税金额总计"],
          "部门": ["成本中心.名称", "成本中心"],
          "法人主体": ["公司"],
          "客户区域": ["客户.客户区域"]
        },
        "金额除数": 1
      },

      "回款": {
        "文件名": "回款.xlsx",
        "Sheet": ["Sheet1", "列表数据"],
        "引擎": "openpyxl",
        "列映射": {
          "日期": ["业务日期", "收款日期", "创建时间"],
          "客户": ["付款人(客户).名称", "付款人名称", "付款人(客户).姓名", "客户.名称"],
          "金额": ["应收金额", "实收", "收款金额", "金额"],
          "部门": ["成本中心.名称", "成本中心"],
          "法人主体": ["公司", "收款公司"],
          "客户区域": ["付款人(客户).客户区域", "客户.客户区域"]
        },
        "金额除数": 1
      },

      "广东公司": {
        "_说明": "独立格式(部门固定检测,金额单位万元), 同样过客户白名单。",
        "文件名": "广东公司.xlsx",
        "Sheet": {"收入": ["收入"], "回款": ["回款"]},
        "引擎": "openpyxl",
        "列映射": {
          "日期": ["日期", "时间"],
          "客户": ["客户", "客户名称"],
          "金额": ["金额", "金额(万元)"]
        },
        "金额除数": 10000,
        "事业部固定": "检测"
      },

      "湖南公司": {
        "_说明": "独立格式(部门固定信息,金额单位万元), 同样过客户白名单。",
        "文件名": "湖南公司.xlsx",
        "Sheet": {"收入": ["收入"], "回款": ["回款"]},
        "引擎": "openpyxl",
        "列映射": {
          "日期": ["日期", "时间"],
          "客户": ["客户", "客户名称"],
          "金额": ["金额", "金额(万元)"]
        },
        "金额除数": 10000,
        "事业部固定": "信息"
      }
    },

    "运营端": {
      "文件夹": "data/raw/运营端数据",

      "收入": {
        "文件名": "收入.xls",
        "Sheet": ["Sheet1"],
        "引擎": "xlrd",
        "列映射": {
          "日期": ["确认时间", "到款时间", "时间", "日期"],
          "客户": ["客户", "客户名称"],
          "金额": ["收入", "金额"],
          "部门": ["事业部", "部门"],
          "内部交易": ["是否属于内部交易", "是否属于内部单位", "是否内部交易", "内部交易"],
          "核算单位": ["核算单位", "法人主体", "所属单位"],
          "法人主体": ["法人主体", "核算单位", "所属单位"]
        },
        "金额除数": 1
      },

      "回款": {
        "文件名": "回款.xls",
        "Sheet": ["到款", "Sheet1"],
        "引擎": "xlrd",
        "列映射": {
          "日期": ["到款时间", "确认时间", "时间", "日期"],
          "客户": ["客户", "客户名称"],
          "金额": ["到款", "金额", "回款"],
          "部门": ["事业部", "部门"],
          "内部交易": ["是否属于内部款项", "是否属于内部单位", "是否内部款项", "内部款项"],
          "核算单位": ["核算单位", "法人主体", "所属单位"],
          "法人主体": ["法人主体", "核算单位", "所属单位"]
        },
        "金额除数": 1
      }
    }
  },

  "年基线数据": {
    "_说明": "往年同比基线数据源。Phase 0 清洗引擎读取此配置查找文件路径（不再 glob 通配取首个）。",
    "收入": {
      "文件夹": "data/raw/往年收入数据",
      "文件名": "往年年收入.xlsx"
    },
    "回款": {
      "文件夹": "data/raw/往年回款数据",
      "文件名": "往年年回款.xlsx"
    }
  },

  "客户名单": {
    "_说明": "白名单Excel文件，471个标准客户名",
    "文件名": "客户名单.xlsx",
    "文件夹": "data/raw/客户名单"
  },

  "映射文件": {
    "_说明": "部门事业部映射 → 财务端+运营端共用。客户名单 → 仅财务端白名单过滤，运营端全量通过不筛选。",
    "部门事业部映射": "data/mappings/部门事业部映射/部门事业部映射.json",
    "客户名单": "data/mappings/客户名单/客户名单.json"
  },

  "时间范围": {
    "_说明": "手动模式：直接改日期重新运行即生效。用于渲染层banner + Phase 1+2 数据筛选。",

    "年度累计": {
      "start_date": "2026-01-01",
      "end_date": "2026-08-31 23:59:59",
      "_使用方": "数据总览/年度达成/销售达成/年度同比"
    },

    "月度数据": {
      "start_date": "2026-08-01",
      "end_date": "2026-08-31 23:59:59",
      "_使用方": "月度达成页"
    },

    "季度累计筛选": {
      "start_date": "2026-07-01",
      "end_date": "2026-09-30 23:59:59",
      "_使用方": "季度达成页"
    },

    "年基线数据": {
      "_说明": "往年同比基线。Phase 0 清洗用年份+月份范围，Phase 4 同比计算直接汇总对比。",
      "年份": 2025,
      "月份范围": [1, 8],
      "_使用方": "Phase 0 年基线清洗 + Phase 4 年度同比计算"
    }
  },

  "输出": {
    "_说明": "清洗引擎输出目录。Phase 0 写前2项，Phase 1+2 写中间6项，Phase 3 销售引擎写后2项。",
    "往年收入": "data/sheets/系统数据清理/往年收入/",
    "往年回款": "data/sheets/系统数据清理/往年回款/",
    "月收入": "data/sheets/系统数据清理/月收入/",
    "月回款": "data/sheets/系统数据清理/月回款/",
    "当年累计收入": "data/sheets/系统数据清理/当年累计收入/",
    "当年累计回款": "data/sheets/系统数据清理/当年累计回款/",
    "季度累计收入": "data/sheets/系统数据清理/季度累计收入/",
    "季度累计回款": "data/sheets/系统数据清理/季度累计回款/",
    "销售收入": "data/sheets/系统数据清理/销售收入/",
    "销售回款": "data/sheets/系统数据清理/销售回款/",
    "标准列": ["事业部", "金额", "客户", "法人主体", "日期"],
    "金额单位": "元"
  },

  "手工指标表": {
    "_说明": "6张独立目标表，人工维护。每张按 客户/销售/4部门 列结构。",
    "年度收入总指标": "data/sheets/手动维护/年度收入总指标/",
    "年度回款总指标": "data/sheets/手动维护/年度回款总指标/",
    "季度收入指标": "data/sheets/手动维护/季度收入指标/",
    "季度回款指标": "data/sheets/手动维护/季度回款指标/",
    "月度收入指标": "data/sheets/手动维护/月度收入指标/",
    "月度回款指标": "data/sheets/手动维护/月度回款指标/"
  }
}
