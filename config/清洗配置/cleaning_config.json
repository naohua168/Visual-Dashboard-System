{
  "数据源": {
    "财务端": {
      "文件夹": "data/raw/财务端数据",
      "收入": {
        "文件名": "收入.xlsx",
        "Sheet": ["Sheet1"],
        "引擎": "openpyxl",
        "列映射": {
          "日期": ["创建时间", "创建日期", "审核日期"],
          "客户": ["客户.名称", "客户名称", "客户.姓名"],
