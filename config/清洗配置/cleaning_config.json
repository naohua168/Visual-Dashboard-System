      "end_date": "2026-06-30 23:59:59"
    },
    "季度累计筛选": {
      "_comment": "手动模式：季度达成页 banner + 季度累计数据筛选（仅 Phase 1+2 清洗用）",
      "start_date": "2026-05-01",
      "end_date": "2026-06-30 23:59:59"
    }
  },

  "客户匹配": {
    "去空格模糊匹配": true,
