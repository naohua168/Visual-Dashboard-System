        "金额除数": 1,
        "日期筛选": "财务端筛选"
      },
      "广东公司": {
        "文件名": "广东公司.xlsx",
        "Sheet": {"收入": ["收入"], "回款": ["回款"]},
        "引擎": "openpyxl",
        "列映射": {
          "日期": ["日期", "时间"],
          "客户": ["客户", "客户名称"],
          "金额": ["金额", "金额(万元)"]
        },
        "金额除数": 10000,
        "事业部固定": "检测",
        "是否为广东公司": "是",
        "日期筛选": "财务端筛选"
      },
      "湖南公司": {
        "文件名": "湖南公司.xlsx",
        "Sheet": {"收入": ["收入"], "回款": ["回款"]},
        "引擎": "openpyxl",
        "列映射": {
          "日期": ["日期", "时间"],
          "客户": ["客户", "客户名称"],
          "金额": ["金额", "金额(万元)"]
        },
        "金额除数": 10000,
        "事业部固定": "信息"
      }
    },
    "运营端": {
      "文件夹": "data/raw/运营端数据",
      "收入": {
        "文件名": "收入.xls",
        "Sheet": ["Sheet1"],
        "引擎": "xlrd",
        "列映射": {
          "日期": ["确认时间", "时间", "日期"],
          "客户": ["客户", "客户名称"],
          "金额": ["收入", "金额"],
          "部门": ["事业部", "部门"],
          "内部交易": ["是否属于内部交易", "是否内部交易", "内部交易"],
          "核算单位": ["核算单位", "法人主体", "所属单位"]
        },
        "金额除数": 1,
        "广东公司全部保留": true
      },
      "回款": {
        "文件名": "回款.xls",
        "Sheet": ["到款", "Sheet1"],
        "引擎": "xlrd",
        "列映射": {
          "日期": ["到款时间", "时间", "日期"],
          "客户": ["客户", "客户名称"],
          "金额": ["到款", "金额", "回款"],
          "部门": ["事业部", "部门"],
          "内部交易": ["是否属于内部款项", "是否内部款项", "内部款项"],
          "核算单位": ["核算单位", "法人主体", "所属单位"]
        },
        "金额除数": 1,
        "广东公司全部保留": true
      }
    }
  },

  "映射文件": {
    "_说明": "仅清洗引擎(Phase 0/1/2)需要的映射。销售规则由 sales 引擎及渲染层从 config/清洗配置/ 下直接加载。",
